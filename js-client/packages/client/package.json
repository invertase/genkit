{
  "name": "@genkit-ai/client",
  "description": "Headless browser-safe client for invoking Genkit actions over the callable HTTP protocol.",
  "version": "0.1.0",
  "type": "commonjs",
  "scripts": {
    "check": "tsc",
    "compile": "tsup-node",
    "build:clean": "rimraf ./lib",
    "build": "npm-run-all build:clean check compile",
    "build:watch": "tsup-node --watch",
    "test": "npm-run-all test:unit test:integration test:types",
    "test:unit": "node --loader tsx --test tests/unit/*_test.ts",
    "test:integration": "node --loader tsx --test tests/integration/*_test.ts",
    "test:types": "tsc --noEmit -p tests/types/tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/genkit-ai/genkit.git",
    "directory": "js-client/packages/client"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@genkit-ai/core": "workspace:*"
  },
  "peerDependencies": {
    "genkit": "workspace:^"
  },
  "peerDependenciesMeta": {
    "genkit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@genkit-ai/client-test-server": "workspace:*",
    "@types/node": "^22.15.3",
    "genkit": "workspace:*",
    "get-port": "^5.1.0",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  },
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.mjs",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    }
  }
}
